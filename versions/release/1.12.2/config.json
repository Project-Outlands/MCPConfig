{
  "java_target": 25,
  "mcinjector": {
    "version": "de.oceanlabs.mcp:mcinjector:3.8.12:fatjar",
    "args": [
      "--in",
      "{input}",
      "--out",
      "{output}",
      "--log",
      "{log}",
      "--lvt=LVT",
      "--exc",
      "{exceptions}",
      "--acc",
      "{access}",
      "--ctr",
      "{constructors}"
    ],
    "repo": "https://maven.outlands.top/releases/"
  },
  "fernflower": {
    "version": "org.vineflower:vineflower:1.12.0",
    "java_version": 25,
    "args": [
      "-din=1",
      "-rbr=1",
      "-dgs=1",
      "-asc=1",
      "-rsy=1",
      "-iec=1",
      "-jvn=1",
      "-nls=1",
      "--prettify-ifs=false",
      "-log=TRACE",
      "-cfg",
      "{libraries}",
      "{input}",
      "{output}"
    ],
    "jvmargs": [
      "-Xmx4G"
    ],
    "repo": "https://repo1.maven.org/maven2/"
  },
  "merge": {
    "version": "top.outlands:mergetool:1.2.11:fatjar",
    "args": [
      "--merge",
      "--client",
      "{client}",
      "--server",
      "{server}",
      "--ann",
      "{version}",
      "--output",
      "{output}",
      "--inject",
      "false"
    ],
    "repo": "https://maven.outlands.top/releases/"
  },
  "rename": {
    "version": "net.minecraftforge:renamer:2.2.8:all",
    "args": [
      "--input",
      "{input}",
      "--output",
      "{output}",
      "--map",
      "{mappings}",
      "--strip-sigs"
    ],
    "repo": "https://maven.minecraftforge.net/"
  },
  "libraries": {
    "client": [
      "com.google.code.findbugs:jsr305:3.0.2"
    ],
    "server": [
      "com.google.code.findbugs:jsr305:3.0.2"
    ],
    "joined": [
      "com.google.code.findbugs:jsr305:3.0.2",
      "top.outlands:mergetool-fml:1.0"
    ]
  },
  "process": {
    "version": "net.minecraftforge:mcpcleanup:2.4.5:fatjar",
    "args": [
      "--input",
      "{input}",
      "--output",
      "{output}"
    ],
    "repo": "https://maven.minecraftforge.net/"
  }
}
